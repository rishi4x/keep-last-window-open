{
  "manifest_version": 3,
  "name": "Keep Last Window Open",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "version": "1.2.0",
  "description": "Prevents the last window from closing by maintaining a pinned buffer tab",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  }
}
